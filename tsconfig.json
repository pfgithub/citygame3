{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": { "box2d-compat": ["./node_modules/box2d3-wasm/build/dist/es/compat/Box2D.compat.d.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
